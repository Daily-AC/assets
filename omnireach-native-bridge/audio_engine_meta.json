          "end": 1.0967083333333334
        },
        {
          "id": "w1",
          "text": "没有 OpenCLI。",
          "start": 1.2867083333333333,
          "end": 2.4567083333333333
        },
        {
          "id": "w2",
          "text": "返回 adapter，",
          "start": 2.646708333333333,
          "end": 3.9054166666666665
        },
        {
          "id": "w3",
          "text": "是 native-chrome。",
          "start": 4.095416666666667,
          "end": 5.994416666666667
        },
        {
          "id": "w4",
          "text": "errors 为空，可见 Chrome，",
          "start": 6.184416666666667,
          "end": 8.547500000000001
        },
        {
          "id": "w5",
          "text": "窗口和标签页，",
          "start": 8.7375,
          "end": 9.996500000000001
        },
        {
          "id": "w6",
          "text": "都是零到零。",
