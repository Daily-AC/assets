        {
          "id": "w0",
          "text": "Agent 搜个抖音，怎么又弹",
          "start": 0.08,
          "end": 2.932916666666667
        },
        {
          "id": "w1",
          "text": "Chrome？",
          "start": 3.052916666666667,
          "end": 3.6719583333333334
        }
      ],
      "provider": "qwen3-tts",
      "runtime": "mlx-audio",
      "model": "mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit",
      "voice": "Vivian",
      "sample_rate_hz": 24000,
      "sha256": "55d9e072eb440c44a16dfc368eadfd19794311d48e8dc4f45ec0dc8d70522224"
    },
    {
      "id": "02",
      "path": "assets/voice/02.wav",
      "duration_s": 10.4,
      "words": [
        {
          "id": "w0",
          "text": "搜索和读取，只是只读任务。",
          "start": 0.08,
          "end": 2.7786666666666666
        },
        {
          "id": "w1",
          "text": "没必要每次启动整套 Playwright。",
          "start": 2.9686666666666666,
          "end": 5.01725
        },
        {
          "id": "w2",
          "text": "点击、表单、上传和视觉检查，",
          "start": 5.20725,
          "end": 8.705583333333333
        },
        {
          "id": "w3",
          "text": "仍然交给它。",
          "start": 8.895583333333333,
          "end": 9.994499999999999
        }
      ],
      "provider": "qwen3-tts",
      "runtime": "mlx-audio",
      "model": "mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit",
      "voice": "Vivian",
      "sample_rate_hz": 24000,
      "sha256": "0d15ef8db0f74a76c77625b4ecb8fefd99316b060d24776eb6af54ea144f7b71"
    },
    {
      "id": "03",
      "path": "assets/voice/03.wav",
      "duration_s": 6.7,
      "words": [
        {
          "id": "w0",
          "text": "Omnireach",
          "start": 0.08,
          "end": 1.24275
        },
        {
          "id": "w1",
          "text": "直接连接你已经登录的 Chrome，",
          "start": 1.43275,
          "end": 3.5717916666666665
        },
        {
          "id": "w2",
          "text": "只继承登录态，不读取密码。",
          "start": 3.7617916666666664,
          "end": 6.220333333333333
        }
      ],
      "provider": "qwen3-tts",
      "runtime": "mlx-audio",
      "model": "mlx-community/Qwen3-TTS-12Hz-1.7B-CustomVoice-6bit",
      "voice": "Vivian",
